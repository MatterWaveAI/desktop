{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MatterWave",
  "version": "0.2.1",
  "identifier": "dev.matterwave.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir web dev",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MatterWave",
        "width": 1200,
        "height": 800,
        "minWidth": 400,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-85xKhsK7IauNKI/aYKVegAwviW1EyL+LzqZwmV7/wYc='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https: ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["matterwave"]
      }
    },
    "updater": {
      "pubkey": "UNSET: scripts/release-config.mjs writes MW_UPDATER_PUBKEY here at release time",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
