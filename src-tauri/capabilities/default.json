{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window may call the app's own commands and nothing else: no filesystem, shell or HTTP plugin is exposed to the webview.",
  "windows": ["main"],
  "permissions": [
    "allow-get-access-token",
    "allow-sign-in",
    "allow-sign-out",
    "allow-open-external",
    "allow-app-info",
    "allow-check-for-updates",
    "allow-notify-generation-complete",
    "allow-install-update",
    "allow-pending-update",
    "allow-set-api-key",
    "allow-clear-api-key",
    "allow-api-key-state"
  ]
}
