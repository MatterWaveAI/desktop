{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window may call the app's own commands and listen for the events the native side emits, and nothing else: no filesystem, shell, dialog or HTTP plugin is exposed to the webview. The agent-* commands are the native tool host (src/agent), off until the person turns agent mode on; each confines its paths itself.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-access-token",
    "allow-sign-in",
    "allow-sign-out",
    "allow-open-external",
    "allow-app-info",
    "allow-check-for-updates",
    "allow-notify-generation-complete",
    "allow-send-test-notification",
    "allow-install-update",
    "allow-pending-update",
    "allow-set-api-key",
    "allow-clear-api-key",
    "allow-api-key-state",
    "allow-pair-device",
    "allow-device-pairing-state",
    "allow-unpair-device",
    "allow-global-shortcut-state",
    "allow-set-global-shortcut",
    "allow-take-navigation",
    "allow-autostart-state",
    "allow-set-autostart",
    "allow-set-recent-conversations",
    "core:webview:allow-set-webview-zoom",
    "allow-agent-state",
    "allow-agent-set-enabled",
    "allow-agent-pick-root",
    "allow-agent-trust-root",
    "allow-agent-start-run",
    "allow-agent-stop-run",
    "allow-agent-read-file",
    "allow-agent-list-dir",
    "allow-agent-glob",
    "allow-agent-grep",
    "allow-agent-edit",
    "allow-agent-write-file",
    "allow-agent-run-shell",
    "allow-agent-checkpoints",
    "allow-agent-restore",
    "allow-agent-pi-rpc-turn"
  ]
}
